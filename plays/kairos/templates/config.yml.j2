#jinja2: lstrip_blocks: True
#cloud-config

{% if hostvars[host].kairos__extra_cmdline | default([]) | length > 0 %}
{# All nodes use the same mack-kairos image, so put hardware-specific
   arguments in `kairos__extra_cmdline`.

   Kairos applies `grub_options` only at first-install, because the
   `GrubFirstBootOptions` hook does not run when
   `/usr/local/.kairos/sentinel_firstboot` exists.  For an installed node,
   `plays/kairos/upgrade.yml` writes the same GRUB variable with
   `grub2-editenv`. #}
grub_options:
  extra_cmdline: "{{ hostvars[host].kairos__extra_cmdline | join(' ') }}"
{% endif %}

hostname: {{ hostvars[host].inventory_hostname }}

users:
  - name: kairos
    lock_passwd: true
    groups:
      - admin
    ssh_authorized_keys:
{% for item in common__keys %}
      - {{ item.type }} {{ item.key }}
{% endfor %}
{# The `common-users` role does not run on a Kairos host, so these
   blocks are the only thing that creates these accounts here.  The
   uid and the gid match the other hosts, so /home stays consistent. #}
{% for user in common__unix_users + hostvars[host].common__host_unix_users | default([]) %}
  {% set group = (common__unix_groups + hostvars[host].common__host_unix_groups | default([])) | selectattr('name', 'equalto', user.name) | first | default(none) %}
  - name: {{ user.name }}
    {% if group is not none and user.group is not defined %}
    gid: "{{ group.gid }}"
    {% endif %}
    {% set extra_groups = (['admin'] if (user.sudo | default(false) or (group is not none and group.sudo | default(false))) else []) + (user.extra_groups | default([])) %}
    {% if extra_groups | length > 0 %}
    groups:
    {% for extra_group in extra_groups %}
      - {{ extra_group }}
    {% endfor %}
    {% endif %}
    {% if user.password | default('') | length > 0 %}
    passwd: "{{ user.password }}"
    {% else %}
    lock_passwd: true
    {% endif %}
    {% if user.group is defined %}
    primary_group: {{ user.group }}
    {% endif %}
    {% if user.shell is defined %}
    shell: {{ user.shell }}
    {% endif %}
    {% if user.authorized_keys | default([]) | length > 0 %}
    ssh_authorized_keys:
    {% for key in user.authorized_keys %}
      - {{ key }}
    {% endfor %}
    {% endif %}
    uid: "{{ user.uid }}"
{% endfor %}

{% if hostvars[host].k3s_controlplane %}
# Note that Kairos does not update this after first-install.  The service unit is managed by ansible.
# See k3s.service.j2
k3s:
  args:
    - --etcd-s3
    - --etcd-s3-config-secret=etcd-s3-secret
    - --flannel-backend=host-gw
    - --flannel-iface=services
{# `%%` escapes a literal `%` for systemd.  See the note in
   `k3s-agent.service.j2`. #}
{% for arg in hostvars[host].k3s_kubelet_args | default([]) %}
    - --kubelet-arg={{ arg | replace('%', '%%') }}
{% endfor %}
    - --node-ip={{ hostvars[host].common__ip_addresses | ansible.utils.ipaddr('10.11.0.0/23') | ansible.utils.ipaddr('address') | first }}
{% for label in hostvars[host].k3s_node_labels | default([]) %}
    - --node-label={{ label }}
{% endfor %}
    - --node-name={{ hostvars[host].inventory_hostname_short }}
{% for taint in hostvars[host].k3s_node_taints | default([]) %}
    - --node-taint={{ taint }}
{% endfor %}
{% if hostvars[host].k3s_cluster_init | default(False) %}
    - --cluster-init
{% else %}
    - --server https://{{ hostvars[groups[hostvars[host].k3s_controlplane_group] | first].inventory_hostname }}:6443
{% endif %}
    - --cluster-cidr=172.16.0.0/16
    - --service-cidr=172.17.0.0/16
    - --disable=metrics-server,traefik,servicelb
    - --disable-helm-controller
{% for tls_san in hostvars[host].k3s_controlplane_san %}
    - --tls-san={{ tls_san }}
{% endfor %}
{% else %}
# Note that Kairos does not update this after first-install.  The service unit is managed by ansible.
# See k3s-agent.service.j2
k3s-agent:
  args:
    - --flannel-iface=services
{# `%%` escapes a literal `%` for systemd.  See the note in
   `k3s-agent.service.j2`. #}
{% for arg in hostvars[host].k3s_kubelet_args | default([]) %}
    - --kubelet-arg={{ arg | replace('%', '%%') }}
{% endfor %}
    - --node-ip={{ hostvars[host].common__ip_addresses | ansible.utils.ipaddr('10.11.0.0/23') | ansible.utils.ipaddr('address') | first }}
{% for label in hostvars[host].k3s_node_labels | default([]) %}
    - --node-label={{ label }}
{% endfor %}
    - --node-name={{ hostvars[host].inventory_hostname_short }}
{% for taint in hostvars[host].k3s_node_taints | default([]) %}
    - --node-taint={{ taint }}
{% endfor %}
{% endif %}
  enabled: true
  env:
    K3S_TOKEN: "{{ hostvars[host].k3s_token }}"
{% if not hostvars[host].k3s_controlplane %}
    K3S_URL: https://{{ hostvars[groups[hostvars[host].k3s_controlplane_group] | first].inventory_hostname }}:6443
{% endif %}

stages:
{% set keyed_users = (common__unix_users + hostvars[host].common__host_unix_users | default([]))
     | selectattr('authorized_keys', 'defined') | list %}
{% set disks_to_format = hostvars[host].kairos__disks_to_format | default([]) %}
{% if disks_to_format | length > 0 or keyed_users | length > 0 %}
  boot:
{% endif %}
{% if disks_to_format | length > 0 %}
{% for disk in disks_to_format %}
{% if 'nvme' in disk %}
{% set partition_path = "%sp1" % disk %}
{% else %}
{% set partition_path = "%s1" % disk %}
{% endif %}
    - name: Prep disk {{ disk }}
      directories:
        - path: /usr/local/disk{{ loop.index0 }}
          permissions: 0600
          owner: 0
          group: 0
      layout:
        device:
          path: {{ disk }}
        expand_partitions:
          size: 0 # Full Disk
        add_partitions:
          - pLabel: primary
            filesystem: ext4
    - name: Mount disk {{ disk }}
      commands:
        - rm -rf /usr/local/disk{{ loop.index0 }}/*
        - mount -o rw {{ partition_path }} /usr/local/disk{{ loop.index0 }}
        - mkdir -p /usr/local/disk{{ loop.index0 }}/garage
        - mkdir -p /usr/local/disk{{ loop.index0 }}/longhorn
{% endfor %}
{% endif %}
{# yip adds an `ssh_authorized_keys` entry, and it never removes one.  A key
   that leaves the list stays on the host.  This step writes the whole file on
   each boot. #}
{% for user in keyed_users %}
  {% set group = (common__unix_groups + hostvars[host].common__host_unix_groups | default([])) | selectattr('name', 'equalto', user.name) | first | default(none) %}
    - name: Write the authorized_keys file of {{ user.name }}
      directories:
        - path: /home/{{ user.name }}/.ssh
          permissions: 0700
          owner: {{ user.uid }}
          group: {{ group.gid if group is not none else user.uid }}
      files:
        - path: /home/{{ user.name }}/.ssh/authorized_keys
          permissions: 0600
          owner: {{ user.uid }}
          group: {{ group.gid if group is not none else user.uid }}
          content: |
{% for key in user.authorized_keys %}
            {{ key }}
{% endfor %}
{% endfor %}
  initramfs:
    - name: Set inotify max values
      sysctl:
        fs.inotify.max_user_instances: "8192"
        fs.inotify.max_user_watches: "524288"
    - name: Set rp_filter for host-gw
      sysctl:
        # Loose (2), not disabled (0): still drops unroutable sources.  Both all and
        # default are needed - the effective value is max(all, iface), and default only
        # seeds interfaces created after this applies.
        net.ipv4.conf.all.rp_filter: "2"
        net.ipv4.conf.default.rp_filter: "2"
    - name: Disable multipath
      systemctl:
        disable:
          - multipathd
          - multipathd.socket
    - name: Setup NTP
      systemctl:
        enable:
          - systemd-timesyncd
      timesyncd:
        NTP: {{ common__ntp_pool }}
        FallbackNTP: ""
    - files:
        # Safety first!  Hard-code control plane nodes and other important things in /etc/hosts...
        - path: /etc/hosts
          permissions: 0644
          content: |
            127.0.0.1 localhost {{ hostvars[host].inventory_hostname }}
            10.11.0.14 services-nfs.hogs.tswn.us
            10.11.1.73 pool.ntp.hogs.tswn.us
{% for host in controlplane_hosts %}
            {{ hostvars[host].ansible_host }} {{ host }}
{% endfor %}
{% if "common__interfaces" in hostvars[host] and "bonds" in hostvars[host].common__interfaces %}
        # This host has multiple NICs with a bond for failover.
{% for bond in hostvars[host].common__interfaces.bonds %}
        # Setup {{ bond.name }}.
        - path: /etc/systemd/network/01-{{ bond.name }}.netdev
          permissions: 0644
          content: |
            [NetDev]
            Name={{ bond.name }}
            Kind=bond
            [Bond]
            Mode={{ bond.mode }}
            PrimaryReselectPolicy=always
            MIIMonitorSec=1s
        - path: /etc/systemd/network/01-{{ bond.name }}.network
          permissions: 0644
          content: |
            [Match]
            Name={{ bond.name }}
            [Network]
            Bridge={{ bond.bridge_name }}
        # Setup the bridge for the bond.
        - path: /etc/systemd/network/02-{{ bond.bridge_name }}.netdev
          permissions: 0644
          content: |
            [NetDev]
            Name={{ bond.bridge_name }}
            Kind=bridge
        # Setup Supported VLANs for {{ bond.bridge_name }}.
        - path: /etc/systemd/network/01-{{ bond.bridge_name }}.network
          permissions: 0644
          content: |
            [Match]
            Name={{ bond.bridge_name }}
            [Network]
            LinkLocalAddressing=no
{% for network in hostvars[host].kairos_managed_networks %}
            VLAN={{ network.name }}
{% endfor %}
        # Slaves for {{ bond.name }}.
{% for slave in bond.slaves %}
        - path: /etc/systemd/network/05-slave-{{ slave.mac | replace(':', '-') }}-{{ bond.name }}.network
          permissions: 0644
          content: |
            [Match]
            PermanentMACAddress={{ slave.mac }}
            [Network]
            Bond={{ bond.name }}
{% if slave.primary | default(false) %}
            PrimarySlave=true
{% endif %}
{% endfor %}
{% endfor %}
{% else %}
        # This host only has a single NIC.
        - path: /etc/systemd/network/02-uplink.netdev
          permissions: 0644
          content: |
            [NetDev]
            Name=uplink
            Kind=bridge
            MACAddress={{ (hostvars[host].common__interfaces.interfaces | first).mac }}
        # Link the single NIC to the uplink bridge.
        - path: /etc/systemd/network/01-{{ (hostvars[host].common__interfaces.interfaces | first).name }}.network
          permissions: 0644
          content: |
            [Match]
            Name={{ (hostvars[host].common__interfaces.interfaces | first).name }}
            [Network]
            Bridge=uplink
        # Setup Supported VLANs for the interface and link the bridge to it.
        - path: /etc/systemd/network/01-uplink.network
          permissions: 0644
          content: |
            [Match]
            Name=uplink
            [Network]
            LinkLocalAddressing=no
{% for network in hostvars[host].kairos_managed_networks %}
            VLAN={{ network.name }}
{% endfor %}
{% endif %}
        # VLAN setup for any managed networks.
{% for network in hostvars[host].kairos_managed_networks %}
        - path: /etc/systemd/network/10-{{ network.name }}.netdev
          permissions: 0644
          content: |
            [NetDev]
            Name={{ network.name }}
            Kind=vlan
            [VLAN]
            Id={{ network.vlan_id }}
        - path: /etc/systemd/network/10-{{ network.name }}.network
          permissions: 0644
          content: |
            [Match]
            Name={{ network.name }}
            [Network]
{% if 'address' in network and network['address'] %}
            Address={{ network.address }}
{% endif %}
{% if 'gateway' in network %}
{% for dns_server in network.dns %}
            DNS={{ dns_server }}
{% endfor %}
            Gateway={{ network.gateway }}
{% endif %}
{% endfor %}
    - name: Configure suborindate GID/UID mappings for the root user
      commands:
        - |
          if ! grep -q "root" /etc/subgid; then
            echo "root:100000:65536" >> /etc/subgid
          fi
          if ! grep -q "root" /etc/subuid; then
            echo "root:100000:65536" >> /etc/subuid
          fi
  fs:
    # This step can go away once https://github.com/kairos-io/packages/pull/1011 is released.
    - name: Ensure kairos owns files in its user directory
      commands:
        - chown -R kairos:kairos ~kairos
