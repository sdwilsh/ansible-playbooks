{
  "$schema": "https://www.getbifrost.ai/schema",
  "client": {
    "allowed_origins": [
      "https://bifrost.hogs.tswn.us"
    ],
    "drop_excess_requests": true,
    "enforce_auth_on_inference": true,
    "initial_pool_size": 10,
    "log_retention_days": 90,
    "max_request_body_size_mb": 32,
    "mcp_disable_auto_tool_inject": true,
    "mcp_external_client_url": "https://bifrost.hogs.tswn.us",
    "whitelisted_routes": [
      "/metrics"
    ]
  },
  "config_store": {
    "config": {
      "db_name": "env.PG_DBNAME",
      "host": "env.PG_HOST",
      "max_idle_conns": 2,
      "max_open_conns": 5,
      "password": "env.PG_PASSWORD",
      "port": "5432",
      "ssl_mode": "require",
      "user": "env.PG_USER"
    },
    "enabled": true,
    "type": "postgres"
  },
  "encryption_key": "env.BIFROST_ENCRYPTION_KEY",
  "governance": {
    "auth_config": {
      "admin_password": "env.BIFROST_ADMIN_PASSWORD",
      "admin_username": "env.BIFROST_ADMIN_USERNAME",
      "is_enabled": true
    }
  },
  "logs_store": {
    "config": {
      "db_name": "env.PG_DBNAME",
      "host": "env.PG_HOST",
      "matview_refresh_interval": "5m",
      "max_idle_conns": 3,
      "max_open_conns": 10,
      "password": "env.PG_PASSWORD",
      "port": "5432",
      "ssl_mode": "require",
      "user": "env.PG_USER"
    },
    "enabled": true,
    "type": "postgres"
  },
  "mcp": {
    "client_configs": [
      {
        "connection_string": "http://argocd-mcp-svc.argocd-mcp.svc.cluster.local:3000/mcp",
        "connection_type": "http",
        "is_code_mode_client": true,
        "name": "argocd",
        "tools_to_execute": [
          "*"
        ]
      },
      {
        "auth_type": "per_user_headers",
        "connection_string": "https://api.githubcopilot.com/mcp/",
        "connection_type": "http",
        "is_code_mode_client": true,
        "name": "github",
        "per_user_header_keys": [
          "Authorization"
        ],
        "tools_to_execute": [
          "*"
        ]
      },
      {
        "connection_string": "http://grafana-mcp-svc.grafana-mcp.svc.cluster.local:8000/mcp",
        "connection_type": "http",
        "is_code_mode_client": true,
        "name": "grafana",
        "tools_to_execute": [
          "*"
        ]
      },
      {
        "auth_type": "headers",
        "client_id": "kagi",
        "connection_string": "https://mcp.kagi.com/mcp",
        "connection_type": "http",
        "headers": {
          "Authorization": "env.KAGI_AUTHORIZATION_HEADER"
        },
        "is_code_mode_client": true,
        "name": "kagi",
        "tool_pricing": {
          "kagi_extract": 0.004,
          "kagi_search_fetch": 0.012
        },
        "tools_to_execute": [
          "kagi_extract",
          "kagi_search_fetch"
        ]
      },
      {
        "connection_string": "http://kubernetes-mcp-svc.kubernetes-mcp.svc.cluster.local:8080/mcp",
        "connection_type": "http",
        "is_code_mode_client": true,
        "name": "kubernetes",
        "tools_to_execute": [
          "*"
        ]
      },
      {
        "connection_string": "http://linux-mcp-svc.linux-mcp.svc.cluster.local:8000/mcp",
        "connection_type": "http",
        "is_code_mode_client": true,
        "name": "linux",
        "tools_to_execute": [
          "*"
        ]
      },
      {
        "connection_string": "http://unifi-network-mcp-svc.unifi-network-mcp.svc.cluster.local:3000/mcp",
        "connection_type": "http",
        "is_code_mode_client": true,
        "name": "unifi",
        "tools_to_execute": [
          "*"
        ]
      }
    ]
  },
  "source_of_truth": "config.json"
}
