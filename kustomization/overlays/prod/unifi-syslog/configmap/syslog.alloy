// The controller sends RFC3164 with no priority header.  loki.source.syslog
// does not accept that.
otelcol.receiver.syslog "unifi" {
  allow_skip_pri_header = true
  on_error              = "drop"
  protocol              = "rfc3164"

  udp {
    add_attributes                = true
    listen_address                = "0.0.0.0:514"
    preserve_trailing_whitespaces = true
  }

  output {
    logs = [otelcol.processor.transform.unifi.input]
  }
}

// Without these labels, all devices share one stream.
otelcol.processor.transform "unifi" {
  log_statements {
    context    = "log"
    statements = [
      `set(attributes["job"], "unifi")`,
      // Always present, unlike the hostname.  Each device has one address.
      `set(attributes["source_ip"], attributes["net.peer.ip"])`,
      // UniFi puts `<mac>,<model>-<firmware>` in the tag field, not the name
      // of the process.  The gateway sends no tag.
      `set(attributes["device_tag"], attributes["appname"]) where attributes["appname"] != nil`,
      // Loki also reads this field to set `detected_level`.  Keep the names
      // that the stored entries use.
      `set(attributes["severity"], "emergency") where severity_text == "emerg"`,
      `set(attributes["severity"], "alert") where severity_text == "alert"`,
      `set(attributes["severity"], "critical") where severity_text == "crit"`,
      `set(attributes["severity"], "error") where severity_text == "err"`,
      `set(attributes["severity"], "warning") where severity_text == "warning"`,
      `set(attributes["severity"], "notice") where severity_text == "notice"`,
      `set(attributes["severity"], "informational") where severity_text == "info"`,
      `set(attributes["severity"], "debug") where severity_text == "debug"`,
      `set(body, attributes["message"]) where attributes["message"] != nil`,
      // Device clocks and time zones vary.  Use the time of receipt.
      `set(time, observed_time)`,
      `set(attributes["loki.format"], "raw")`,
      // Do not add "proc_id".  A process id makes a new stream at each
      // restart.
      `set(attributes["loki.attribute.labels"], "device_tag, hostname, job, severity, source_ip")`,
    ]
  }

  output {
    logs = [otelcol.exporter.loki.unifi.input]
  }
}

otelcol.exporter.loki "unifi" {
  forward_to = [loki.process.unifi.receiver]
}

loki.process "unifi" {
  // otelcol.exporter.loki always adds these labels.
  stage.label_drop {
    values = ["exporter", "level"]
  }

  // The name of the process is in the message, not in the tag field.  The
  // shapes are `proc[pid]: `, `proc: `, `hostname proc[pid]: ` and
  // `proc[pid][pid]: `.  A message of two words and a colon, as
  // `syslogd started: `, gives the wrong word.  That costs no streams, because
  // the value is structured metadata.
  stage.regex {
    expression = `^(?:[\w.-]+ )?(?P<process>[A-Za-z][\w.-]*)(?:\[\d+\])*: `
  }

  // A firewall line has no process.  A chain name can contain a digit, as
  // `CUSTOM5_CUSTOM4`.
  stage.regex {
    expression = `^\[(?P<fw_chain>[A-Z_0-9]+)-[A-Z]-\d+\]`
  }

  // Both stages above are silent when they do not match.  This value makes
  // every entry complete, so a query can count the misses.
  // TODO: alert when `unparsed` is more than 100 each day.  It is 8 today.
  // The Loki ruler holds no rule groups.
  stage.template {
    source   = "process"
    template = `{{ if .Value }}{{ .Value }}{{ else if .fw_chain }}firewall{{ else }}unparsed{{ end }}`
  }

  // These are not labels.  The device controls the text, so the values of
  // "process" have no limit, and each field multiplies the stream count.
  // Do not give a name to an optional group above.  A group that does not
  // match writes an empty value, and this stage keeps it.
  stage.structured_metadata {
    values = {
      device_tag = "",
      fw_chain   = "",
      process    = "",
      severity   = "",
    }
  }

  forward_to = [loki.write.default.receiver]
}
