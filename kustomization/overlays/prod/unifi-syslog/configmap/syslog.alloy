// loki.source.syslog puts the RFC3164 header fields in `__` labels and then
// removes them.  Without these rules, all devices share one stream.
loki.relabel "unifi" {
  // loki.source.syslog below uses only the rules.  This component sends no
  // entries.
  forward_to = []

  rule {
    source_labels = ["__syslog_message_hostname"]
    action        = "replace"
    target_label  = "hostname"
  }

  // Always present, unlike the hostname.  Each device has one address.
  rule {
    source_labels = ["__syslog_connection_ip_address"]
    action        = "replace"
    target_label  = "source_ip"
  }

  // UniFi puts `<mac>,<model>-<firmware>` in the tag field, not the name of
  // the process.  The gateway sends no tag.
  rule {
    source_labels = ["__syslog_message_app_name"]
    action        = "replace"
    target_label  = "device_tag"
  }

  // Loki also reads this field to set `detected_level`.
  rule {
    source_labels = ["__syslog_message_severity"]
    action        = "replace"
    target_label  = "severity"
  }

  // Do not add "__syslog_message_proc_id".  A process id makes a new stream at
  // each restart.
}

loki.source.syslog "unifi" {
  listener {
    address       = "0.0.0.0:514"
    protocol      = "udp"
    syslog_format = "rfc3164"
    labels        = {
      job = "unifi",
    }
  }

  relabel_rules = loki.relabel.unifi.rules
  forward_to    = [loki.process.unifi.receiver]
}

loki.process "unifi" {
  // The name of the process is in the message, not in the tag field.  The
  // shapes are `proc[pid]: `, `proc: `, `hostname proc[pid]: ` and
  // `proc[pid][pid]: `.  A message of two words and a colon, as
  // `syslogd started: `, gives the wrong word.  That costs no streams, because
  // the value is structured metadata.
  stage.regex {
    expression = `^(?:[\w.-]+ )?(?P<process>[A-Za-z][\w.-]*)(?:\[\d+\])*: `
  }

  // A firewall line has no process.  A chain name can contain a digit, as
  // `CUSTOM5_CUSTOM4`.
  stage.regex {
    expression = `^\[(?P<fw_chain>[A-Z_0-9]+)-[A-Z]-\d+\]`
  }

  // Both stages above are silent when they do not match.  This value makes
  // every entry complete, so a query can count the misses.
  // TODO: alert when `unparsed` is more than 100 each day.  It is 8 today.
  // The Loki ruler holds no rule groups.
  stage.template {
    source   = "process"
    template = `{{ if .Value }}{{ .Value }}{{ else if .fw_chain }}firewall{{ else }}unparsed{{ end }}`
  }

  // These are not labels.  The device controls the text, so the values of
  // "process" have no limit, and each field multiplies the stream count.
  // Do not give a name to an optional group above.  A group that does not
  // match writes an empty value, and this stage keeps it.
  stage.structured_metadata {
    values = {
      device_tag = "",
      fw_chain   = "",
      process    = "",
      severity   = "",
    }
  }

  forward_to = [loki.write.default.receiver]
}
