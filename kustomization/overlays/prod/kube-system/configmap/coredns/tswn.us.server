# Send all tswn.us queries to blocky.  Do not send them to the public
# resolvers.  The resolv.conf file on the node lists three servers: blocky and
# two public resolvers.  The forward plugin in the default server block selects
# one of the three servers at random.  Without this block, the public resolvers
# answer most queries for an internal name.  The public resolvers give the
# public Cloudflare address.  For a name that is only internal, they give
# NXDOMAIN.
tswn.us:53 {
    errors
    # This block must read the NodeHosts file, because this block receives all
    # tswn.us queries.  The default server block receives none of them.  k3s
    # writes the node names and the node addresses into that file.
    #
    # The following list holds the names that must resolve when blocky does
    # not answer.  Do not put a name in the NodeHosts file and in this list.
    # The hosts plugin adds this list to the entries from the file.  It does
    # not replace them, and a name in both places gets two records.
    #
    # A name in this list has no PTR record.  A PTR query goes to the
    # 10.in-addr.arpa block, and that block reads the NodeHosts file only.
    # The cluster sends very few PTR queries, so this is acceptable.
    hosts /etc/coredns/NodeHosts {
      10.11.1.64 auth.tswn.us
      10.11.1.64 code.tswn.us
      10.11.1.64 idm.tswn.us
      10.11.1.64 s3.tswn.us
      10.11.1.73 pool.ntp.hogs.tswn.us
      10.11.1.75 dockerhub-proxy.hogs.tswn.us
      ttl 60
      reload 15s
      fallthrough
    }
    prometheus :9153
    # Keep an answer for one hour after it expires.  CoreDNS gives the old
    # answer only when blocky does not answer.  Therefore the names that are
    # not in the list above remain available during a short blocky failure.
    # The timeout of 200ms limits the delay when blocky does not answer.
    cache 30 {
      serve_stale 1h verify 200ms
    }
    loop
    # The health check of the forward plugin sends a query for the root zone
    # by default.  blocky gives a malformed answer to that query, and thus
    # CoreDNS marks blocky as unavailable.  blocky answers correctly for
    # tswn.us, so the health check uses that name.
    forward . 10.11.1.66 {
      health_check 5s domain tswn.us.
    }
}
