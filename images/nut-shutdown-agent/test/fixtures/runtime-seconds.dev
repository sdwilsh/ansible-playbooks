# Exercises `monitor.sh`'s `SHUTDOWN_BELOW_RUNTIME_SECONDS` path in isolation.
# Charge is left healthy throughout, so a false trigger from the
# charge-percent threshold would show up as this scenario failing for the
# wrong reason.
battery.charge: 80
ups.status: OB

# Start above the test's 600s threshold (i.e. `e2e.sh`'s configured value
# for this scenario) so the monitor observes a real crossing rather than
# already being below it at container start.  Three seconds gives
# `e2e.sh`'s readiness poll a comfortable margin to finish before this
# fires.
battery.runtime: 700
TIMER 3
battery.runtime: 500
