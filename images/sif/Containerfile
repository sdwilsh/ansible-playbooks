# The commit is the commit of the tag `GUFO_VERSION`.  Renovate changes both lines.
ARG GUFO_VERSION=v0.17.1.0
ARG GUFO_COMMIT=06ef1e5b42ba2173e5edf039bbc27fa391bc3ee2

FROM alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6 AS builder

# hadolint ignore=DL3018
RUN apk add --no-cache \
    ca-certificates \
    curl \
    xz

# renovate: datasource=github-releases depName=just-containers/s6-overlay versioning=loose
ARG S6_OVERLAY_VERSION=v3.2.3.2
WORKDIR /download
RUN mkdir -p /s6root \
  && for part in noarch x86_64; do \
       url="https://github.com/just-containers/s6-overlay/releases/download/${S6_OVERLAY_VERSION}/s6-overlay-${part}.tar.xz"; \
       curl -f -L -O "${url}" \
    && curl -f -L -O "${url}.sha256" \
    && sha256sum -c "s6-overlay-${part}.tar.xz.sha256" \
    && tar -C /s6root -Jxpf "s6-overlay-${part}.tar.xz" \
    || exit 1; \
     done

FROM docker.io/nixos/nix:2.35.3@sha256:ff480dbb23511aa1c10710aa068ceea5b93fed9bfce5f5379f3a6b07282cbc7b AS gufo-builder

ARG GUFO_VERSION
ARG GUFO_COMMIT
# A build can set a local flake source, for example `git+file:///gufo-src?rev=...`.
ARG GUFO_FLAKE_REF=github:sdwilsh/gufo/${GUFO_COMMIT}
# The expression sets the release version.  The flake accepts only X.Y.Z in `version.txt`.
# hadolint ignore=DL4006
RUN echo "experimental-features = nix-command flakes" >> /etc/nix/nix.conf \
  && nix build --out-link /gufo-result --expr " \
       (builtins.getFlake \"${GUFO_FLAKE_REF}\").packages.x86_64-linux.default.override { \
         releaseVersion = \"${GUFO_VERSION#v}\"; }" \
  && ! LD_TRACE_LOADED_OBJECTS=1 /gufo-result/bin/gufo | grep 'not found'

# The image gets `ps` from the nixpkgs that the gufo flake pins.
RUN nix build --out-link /procps-result --expr " \
       (builtins.getFlake \"${GUFO_FLAKE_REF}\").inputs.nixpkgs.legacyPackages.x86_64-linux.procps"

# hadolint ignore=DL4006,SC3040
RUN set -o pipefail \
  && mkdir -p /rootfs/nix/store /rootfs/usr/local/bin \
  && nix-store -qR /gufo-result /procps-result | tee /closure.txt | xargs cp -a -t /rootfs/nix/store \
  && ln -s "$(readlink -f /gufo-result)/bin/gufo" /rootfs/usr/local/bin/gufo \
  && ln -s "$(readlink -f /procps-result)/bin/ps" /rootfs/usr/local/bin/ps \
  # These lines print the closure size and any build-only library.
  && wc -l < /closure.txt \
  && { grep -E 'hipcub|rocprim|rocwmma' /closure.txt || true; }

# The base image holds bash, curl and a glibc `ldd` for the closures.
FROM registry.fedoraproject.org/fedora:44@sha256:6ad1739ac6fb30f72ecc7b62a7ca94871d1cab215e4f5174113941047e0b4ed4

ARG GUFO_VERSION
LABEL org.opencontainers.image.version="${GUFO_VERSION}"

COPY --from=gufo-builder /rootfs/ /
COPY --from=builder /s6root/ /
COPY scripts/ /usr/local/bin/
RUN chmod 0755 /usr/local/bin/check-servers.sh \
    /usr/local/bin/check-supervisor.sh \
    /usr/local/bin/generate-model-services.sh

# An exec probe gets this `PATH`.
ENV PATH="/command:${PATH}"

# `rc.init` runs the hook and compiles the tree in the same boot, so both
# read `S6_RUNTIME_BUNDLEDIR`.  A hook that fails must stop the container,
# and the default of `S6_BEHAVIOUR_IF_STAGE2_FAILS` makes it a warning.
# The pod gives `/run` a world-writable `emptyDir` that s6 does not own.
ENV S6_BEHAVIOUR_IF_STAGE2_FAILS=2 \
    S6_READ_ONLY_ROOT=1 \
    S6_RUNTIME_BUNDLEDIR=/run/s6-overlay/s6-rc.d \
    S6_STAGE2_HOOK=/usr/local/bin/generate-model-services.sh \
    S6_YES_I_WANT_A_WORLD_WRITABLE_RUN_BECAUSE_KUBERNETES=1

# The container fails at run time without these files.
# hadolint ignore=DL4006,SC3040
RUN set -o pipefail \
  && test -L /var/run \
  && [ "$(readlink -f /var/run)" = "/run" ] \
  && test -x /usr/local/bin/gufo \
  && test -x /bin/bash \
  && test -x /usr/bin/curl \
  && test -x /usr/local/bin/ps \
  && ! ldd "$(readlink -f /usr/local/bin/ps)" | grep "not found" \
  && ! ldd "$(readlink -f /usr/local/bin/gufo)" | grep "not found" \
  && /usr/local/bin/gufo --version \
  && /usr/local/bin/ps --version \
  && test -x /command/with-contenv \
  && test -x /command/s6-svstat \
  && test -x /command/s6-rc-compile \
  && test -x /usr/local/bin/check-servers.sh \
  && test -x /usr/local/bin/check-supervisor.sh \
  && test -x /usr/local/bin/generate-model-services.sh

ENTRYPOINT ["/init"]
