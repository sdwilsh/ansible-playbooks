# Allow build scripts to be referenced without being copied into the final image.
FROM scratch AS ctx
COPY build_files /

# This stage builds kairos-fedora with Mack's build files.  k3s cluster
# nodes use this image.
FROM ghcr.io/marinatedconcrete/kairos-fedora:0.10.1@sha256:0788f05890392ce10f702f5f7803ba12573365ea99b58ecf7290513e620b8b1a AS mack-kairos

ARG TARGETPLATFORM
ARG GIT_SHA=unknown

# Each stage needs its own cache ID here.  This stage and the mack stage
# below mount the same paths.  A shared ID mixes the two stages' caches.
# A mixed cache can corrupt the ansible-galaxy collection cache.
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=cache,dst=/var/cache,id=mack-kairos-var-cache \
    --mount=type=cache,dst=/var/log,id=mack-kairos-var-log \
    --mount=type=tmpfs,dst=/tmp \
    /ctx/build.sh

# This stage runs on bare-metal Kairos nodes only.
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    /ctx/kairos.sh

# This is the base image.  This stage must stay last.  `just build-mack`
# and `just build-mack-vm` run `podman build` with no `--target` flag.
# Podman then picks the last stage.
FROM quay.io/fedora/fedora-bootc:43

ARG TARGETPLATFORM

RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=cache,dst=/var/cache,id=mack-var-cache \
    --mount=type=cache,dst=/var/log,id=mack-var-log \
    --mount=type=tmpfs,dst=/tmp \
    /ctx/build.sh && \
    ostree container commit

# Verify final image and contents are correct.
RUN bootc container lint
