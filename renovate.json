{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/|\\.)(Container|Docker)file$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>.*?)\\s+depName=(?<depName>.*?)(\\s+registryUrl=(?<registryUrl>.*?))?(\\s+versioning=(?<versioning>.*?))?\\s+ARG\\s+.+_VERSION=(?<currentValue>.*?)\\s"
      ],
      "versioningTemplate": "{{#if versioning}}{{versioning}}{{else}}semver{{/if}}"
    },
    {
      "customType": "regex",
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "gufo-org/gufo",
      "description": "Renovate replaces the tag line and the commit line together, so the commit stays the digest of the tag.",
      "managerFilePatterns": [
        "/^images/sif/Containerfile$/"
      ],
      "matchStrings": [
        "ARG GUFO_VERSION=(?<currentValue>\\S+)\\nARG GUFO_COMMIT=(?<currentDigest>[a-f0-9]{40})"
      ],
      "autoReplaceStringTemplate": "ARG GUFO_VERSION={{{newValue}}}\nARG GUFO_COMMIT={{{newDigest}}}",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/|\\.).*\\.sh$/"
      ],
      "matchStrings": [
        "\\srenovate:\\s+datasource=(?<datasource>.*?)\\sdepName=(?<depName>.*?)\\n\\s*[a-zA-Z_]+=\"?(?<currentValue>.*?)\"?\\s"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^roles/.+/tasks/.+\\.yml$/"
      ],
      "datasourceTemplate": "docker",
      "matchStrings": [
        "#\\s*renovate:(\\s*versioning=(?<versioning>.*?))?\\n\\s*image:\\s*(?<depName>.*?):(?<currentValue>.*?)\\s"
      ],
      "versioningTemplate": "{{#if versioning}}{{versioning}}{{else}}semver{{/if}}"
    },
    {
      "customType": "regex",
      "datasourceTemplate": "docker",
      "managerFilePatterns": [
        "/^kustomization/.+/.+/.*values\\.yml$/"
      ],
      "matchStrings": [
        "image:\\n\\s+repository:\\s+(?<depName>.*?)\\n\\s+tag:\\s+(?<currentValue>.*?)\\n",
        "#\\s*renovate:\\sdatasource=(?<datasource>.*?)\\sdepName=(?<depName>.*?)\\n\\s+tag:\\s(?<currentValue>.*?)\\n"
      ],
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "datasourceTemplate": "docker",
      "managerFilePatterns": [
        "/^kustomization/.+/cnpg/.+\\.yml$/"
      ],
      "matchStrings": [
        "\\s+imageName:\\s+(?<depName>.+):(?<currentValue>.+?)@(?<currentDigest>sha256:[a-f0-9]{64})",
        "\\s+image:\\n\\s+reference:\\s+(?<depName>.+):(?<currentValue>.+?)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "datasourceTemplate": "docker",
      "managerFilePatterns": [
        "/^kustomization/overlays/prod/kube-amd-gpu/deviceconfig/.+\\.yml$/"
      ],
      "matchStrings": [
        "devicePluginImage:\\s+(?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})",
        "nodeLabellerImage:\\s+(?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^kustomization/.+/.+/kustomization\\.yml$/",
        "/^kustomization/.+/.+/.+/kustomization\\.yml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\sdatasource=(?<datasource>.*?)\\sdepName=(?<depName>.*?)(?:\\sversioning=(?<versioning>.*?))?\\n\\s+newTag: (?<currentValue>.*?)\\n",
        "#\\s*renovate:\\sdatasource=(?<datasource>.*?)\\n\\s+- https://raw\\.githubusercontent\\.com/(?<depName>.*?)/(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)",
        "#\\s*renovate:\\sdatasource=(?<datasource>.*?)\\n\\s+- https://github\\.com/(?<depName>.*?)/raw/(?<currentValue>.*?)/",
        "#\\s*renovate:\\sdatasource=(?<datasource>.+?)(?:\\sversioning=(?<versioning>.+?))?\\n\\s+- https://github\\.com/(?<depName>.+/.+?)/?\\?ref=(?<currentValue>.+?)\\n"
      ],
      "versioningTemplate": "{{#if versioning}}{{versioning}}{{else}}semver-coerced{{/if}}"
    },
    {
      "customType": "regex",
      "datasourceTemplate": "github-releases",
      "managerFilePatterns": [
        "/^kustomization/.+/.+/kustomization\\.yml$/",
        "/^kustomization/.+/.+/.+/kustomization\\.yml$/",
        "!kustomization/overlays/prod/keda/kustomization.yml"
      ],
      "matchStrings": [
        "\\s-\\shttps://raw\\.githubusercontent\\.com/(?<depName>cloudnative-pg/cloudnative-pg)/main/releases/cnpg-(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\\.yaml",
        "\\s-\\shttps://github\\.com/(?<depName>.*?/.*?)/releases/download/(?<currentValue>v?[0-9]+\\.[0-9]+\\.[0-9]+)/.+"
      ],
      "versioningTemplate": "{{#if versioning}}{{versioning}}{{else}}semver-coerced{{/if}}"
    },
    {
      "customType": "regex",
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "kedacore/keda",
      "managerFilePatterns": [
        "/^kustomization/overlays/prod/keda/kustomization\\.yml$/"
      ],
      "matchStrings": [
        "- https://github\\.com/kedacore/keda/releases/download/v(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)/keda-[0-9]+\\.[0-9]+\\.[0-9]+\\.yaml"
      ],
      "autoReplaceStringTemplate": "- https://github.com/kedacore/keda/releases/download/v{{{newValue}}}/keda-{{{newValue}}}.yaml",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^plays/.+\\.yml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\sdatasource=(?<datasource>.*?)\\sdepName=(?<depName>.*?)(?:\\sversioning=(?<versioning>.*?))?\\n\\s+[a-zA-Z_]+_version: (?<currentValue>.*?)\\n"
      ],
      "versioningTemplate": "{{#if versioning}}{{versioning}}{{else}}semver-coerced{{/if}}"
    },
    {
      "customType": "regex",
      "datasourceTemplate": "github-releases",
      "managerFilePatterns": [
        "/^kustomization/overlays/prod/traefik/configmap/traefik/static\\.yml$/"
      ],
      "matchStrings": [
        "moduleName:\\s+github\\.com/(?<depName>.*/.*)\\n\\s+version:\\s+(?<currentValue>.*)"
      ]
    },
    {
      "customType": "regex",
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "prometheus/prometheus",
      "managerFilePatterns": [
        "/^kustomization/components/.+/prometheus\\.yml$/",
        "/^kustomization/overlays/.+/.+/prometheus\\.yml$/"
      ],
      "matchStrings": [
        "version:\\s+(?<currentValue>v.*?)\\n"
      ]
    },
    {
      "customType": "regex",
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "authelia/authelia",
      "managerFilePatterns": [
        "/^kustomization/overlays/prod/traefik/configmap/authelia/config\\.yml$/"
      ],
      "matchStrings": [
        "\\$schema=https://www\\.authelia\\.com/schemas/(?<currentValue>v\\d+\\.\\d+)/json-schema/configuration\\.json$"
      ]
    },
    {
      "customType": "regex",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver",
      "managerFilePatterns": [
        "/^kustomization/overlays/prod/kairos-operator/nodeopupgrade/controlplane\\.yml$/"
      ],
      "matchStrings": [
        "name:\\s+kairos-upgrade-control-plane-mack-[0-9]+-[0-9]+-[0-9]+\\nspec:\\n  concurrency: 1\\n  image:\\s+(?<depName>[^:\\s]+):(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "autoReplaceStringTemplate": "name: kairos-upgrade-control-plane-mack-{{{replace '[.]' '-' newValue}}}\nspec:\n  concurrency: 1\n  image: {{{depName}}}:{{{newValue}}}@{{{newDigest}}}"
    },
    {
      "customType": "regex",
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^latest\\.(?<major>\\d{4})(?<minor>\\d{2})(?<patch>\\d{2})$",
      "managerFilePatterns": [
        "/^kustomization/overlays/prod/kairos-operator/nodeopupgrade/workers\\.yml$/"
      ],
      "matchStrings": [
        "name:\\s+kairos-upgrade-workers-mack-[0-9]{8}\\nspec:\\n  concurrency: 1\\n  image:\\s+(?<depName>[^:\\s]+):(?<currentValue>latest\\.[0-9]{8})@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "autoReplaceStringTemplate": "name: kairos-upgrade-workers-mack-{{{replace 'latest[.]' '' newValue}}}\nspec:\n  concurrency: 1\n  image: {{{depName}}}:{{{newValue}}}@{{{newDigest}}}"
    },
    {
      "customType": "regex",
      "datasourceTemplate": "docker",
      "managerFilePatterns": [
        "/^kustomization/overlays/prod/kairos-operator/patches/set_node_labeler_image\\.yml$/"
      ],
      "matchStrings": [
        "name:\\s+NODE_LABELER_IMAGE\\n\\s+value:\\s+(?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "datasourceTemplate": "gitea-tags",
      "registryUrlTemplate": "https://code.tswn.us",
      "managerFilePatterns": [
        "/^kustomization/components/forgejo-runner-operator/kustomization\\.yml$/"
      ],
      "matchStrings": [
        "-\\shttps://code\\.tswn\\.us/(?<depName>.+?)/config/crd\\?ref=(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)\\n"
      ],
      "versioningTemplate": "semver-coerced"
    }
  ],
  "extends": [
    "github>marinatedconcrete/config//renovate/devcontainer#renovate-config-2.7.0",
    "github>marinatedconcrete/config//renovate/marinatedconcrete#renovate-config-2.7.0",
    "github>marinatedconcrete/config//renovate/recommended#renovate-config-2.7.0"
  ],
  "packageRules": [
    {
      "description": "Automatic Minor and Patch Updates",
      "automerge": true,
      "automergeType": "branch",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchPackageNames": [
        "alloy",
        "alpine",
        "argoproj/argo-cd",
        "cert-manager/cert-manager",
        "code.forgejo.org/forgejo-helm/forgejo",
        "deluan/navidrome",
        "docker.io/grafana/alloy",
        "eclipse-mosquitto",
        "ghcr.io/dancwilliams/protonmail-bridge-docker",
        "ghcr.io/squat/generic-device-plugin",
        "gotenberg/gotenberg",
        "grafana",
        "helm/helm",
        "jellyfin/jellyfin",
        "loki",
        "lscr.io/linuxserver/transmission",
        "mbround18/valheim",
        "prometheus-node-exporter",
        "prometheus/prometheus",
        "renovate",
        "stirling-pdf-chart",
        "twpayne/chezmoi"
      ],
      "schedule": [
        "after 4pm on tuesday",
        "after 4pm on thursday",
        "after 4pm on friday",
        "every weekend"
      ]
    },
    {
      "commitBody": "{{#if logJSON.hasReleaseNotes}}{{#each logJSON.versions as |release|}}{{#if release.releaseNotes}}- [{{{release.version}}}]({{{release.releaseNotes.url}}})\n{{/if}}{{/each}}{{/if}}",
      "description": "The Argo release notes make a commit body of more than 200 KB, and the hosted Renovate did not create the argo-cd v3.6.1 branch.  Link to the notes instead.",
      "matchPackageNames": [
        "argoproj/argo-cd",
        "argoproj/argo-rollouts"
      ]
    },
    {
      "description": "Automatic Patch Updates",
      "automerge": true,
      "automergeType": "branch",
      "matchUpdateTypes": [
        "patch"
      ],
      "matchPackageNames": [
        "ghcr.io/immich-app/immich-machine-learning",
        "ghcr.io/immich-app/immich-server",
        "immich"
      ],
      "schedule": [
        "after 4pm every weekday",
        "every weekend"
      ]
    },
    {
      "description": "Automatic Digest Updates",
      "automerge": true,
      "automergeType": "branch",
      "matchPackageNames": [
        "busybox",
        "docker.io/bitnami/kubectl",
        "docker.io/xiahan2019/olah",
        "ghcr.io/blakeblackshear/frigate",
        "ghcr.io/cloudnative-pg/postgresql",
        "ghcr.io/dancwilliams/protonmail-bridge-docker",
        "ghcr.io/marinatedconcrete/devcontainer-base",
        "ghcr.io/sdwilsh/nut-shutdown-agent",
        "postgres",
        "rocm/k8s-device-plugin"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "schedule": [
        "after 4pm"
      ]
    },
    {
      "automerge": true,
      "automergeType": "branch",
      "description": "Build inputs and tooling.  CI builds and lints the branch, and each deploy is a separate update.  Gufo stays manual because each release gets a benchmark.",
      "matchFileNames": [
        ".devcontainer/**",
        "images/**"
      ],
      "matchPackageNames": [
        "!gufo-org/gufo"
      ],
      "matchUpdateTypes": [
        "digest",
        "minor",
        "patch"
      ]
    },
    {
      "automerge": true,
      "automergeType": "branch",
      "description": "GitHub's own actions.  Third-party actions stay manual because the image workflows give them write tokens.",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "actions/*"
      ],
      "matchUpdateTypes": [
        "digest",
        "minor",
        "patch"
      ]
    },
    {
      "description": "Each kustomization pins its images in its images list, and kustomize applies the pins to the chart output.  A pin in a Helm values file only duplicates it.",
      "enabled": false,
      "matchManagers": [
        "helm-values"
      ]
    },
    {
      "enabled": false,
      "groupName": "no-pin",
      "matchUpdateTypes": [
        "pin",
        "pinDigest"
      ],
      "matchPackageNames": [
        "ghcr.io/marinatedconcrete/kairos-fedora",
        "ghcr.io/sdwilsh/mack-kairos",
        "quay.io/fedora/fedora-bootc"
      ]
    },
    {
      "description": "A helmCharts version cannot hold a digest.  A pin of an OCI chart fails the whole pin branch.",
      "matchDepTypes": [
        "HelmChart"
      ],
      "matchManagers": [
        "kustomize"
      ],
      "pinDigests": false
    },
    {
      "automerge": true,
      "automergeType": "branch",
      "description": "Group for all traefik automergeable updates",
      "groupName": "traefik-automerge",
      "matchPackageNames": [
        "11notes/traefik",
        "ghcr.io/authelia/authelia",
        "maxlerebourg/crowdsec-bouncer-traefik-plugin",
        "traefik/traefik"
      ],
      "matchUpdateTypes": [
        "digest",
        "minor",
        "patch"
      ],
      "schedule": [
        "after 4pm on tuesday",
        "after 4pm on thursday",
        "after 4pm on friday"
      ]
    },
    {
      "description": "Control plane takes an image before the workers do.",
      "groupName": "kairos-control-plane",
      "matchFileNames": [
        "kustomization/overlays/prod/kairos-operator/nodeopupgrade/controlplane.yml"
      ],
      "schedule": [
        "after 4pm on tuesday",
        "after 4pm on thursday",
        "after 4pm on friday"
      ]
    },
    {
      "description": "Workers wait for the control plane to take an image first.",
      "groupName": "kairos-workers",
      "matchFileNames": [
        "kustomization/overlays/prod/kairos-operator/nodeopupgrade/workers.yml"
      ],
      "schedule": [
        "after 4pm on tuesday",
        "after 4pm on thursday",
        "after 4pm on friday"
      ]
    },
    {
      "groupName": "kairos-operator",
      "matchPackageNames": [
        "kairos-io/kairos-operator",
        "quay.io/kairos/operator",
        "quay.io/kairos/operator-node-labeler"
      ]
    },
    {
      "groupName": "forgejo-runner-operator",
      "matchPackageNames": [
        "marinatedconcrete/forgejo-runner-operator",
        "code.tswn.us/marinatedconcrete/forgejo-runner-operator/operator",
        "code.tswn.us/marinatedconcrete/forgejo-runner-operator/connection-manager",
        "code.tswn.us/marinatedconcrete/forgejo-runner-operator/job-executor"
      ]
    },
    {
      "allowedVersions": "/^v?\\d+\\.\\d+\\.[1-9]\\d*$/",
      "description": "Group for all Longhorn updates",
      "groupName": "longhorn",
      "matchPackageNames": [
        "longhorn/cli",
        "longhorn/longhorn"
      ]
    },
    {
      "description": "Group for all major traefik updates",
      "groupName": "traefik",
      "matchPackageNames": [
        "11notes/traefik",
        "ghcr.io/authelia/authelia",
        "maxlerebourg/crowdsec-bouncer-traefik-plugin",
        "traefik/traefik"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "schedule": [
        "after 4pm on tuesday",
        "after 4pm on thursday",
        "after 4pm on friday"
      ]
    },
    {
      "description": "Group for all immich updates",
      "groupName": "immich-app",
      "matchPackageNames": [
        "ghcr.io/immich-app/immich-machine-learning",
        "ghcr.io/immich-app/immich-server",
        "immich"
      ]
    },
    {
      "groupName": "postgres-3d-printing",
      "matchFileNames": [
        "kustomization/overlays/prod/3d-printing/**"
      ],
      "matchPackageNames": [
        "ghcr.io/cloudnative-pg/postgresql"
      ],
      "schedule": [
        "after 4pm on monday",
        "after 4pm on thursday"
      ]
    },
    {
      "groupName": "postgres-atuin",
      "matchFileNames": [
        "kustomization/overlays/prod/atuin/**"
      ],
      "matchPackageNames": [
        "ghcr.io/cloudnative-pg/postgresql"
      ],
      "schedule": [
        "after 4pm"
      ]
    },
    {
      "groupName": "postgres-auth",
      "matchFileNames": [
        "kustomization/overlays/prod/auth/**"
      ],
      "matchPackageNames": [
        "ghcr.io/cloudnative-pg/postgresql"
      ],
      "schedule": [
        "after 4pm"
      ]
    },
    {
      "allowedVersions": "/^v\\d+\\.\\d+\\.\\d+$/",
      "description": "This image has a second series of tags with no `v`, and the newest of those is older than the newest release.",
      "groupName": "bifrost",
      "matchPackageNames": [
        "docker.io/maximhq/bifrost"
      ],
      "minimumReleaseAge": "7 days"
    },
    {
      "groupName": "postgres-bifrost",
      "matchFileNames": [
        "kustomization/overlays/prod/bifrost/**"
      ],
      "matchPackageNames": [
        "ghcr.io/cloudnative-pg/postgresql"
      ],
      "schedule": [
        "after 4pm"
      ]
    },
    {
      "groupName": "postgres-crowdsec",
      "matchFileNames": [
        "kustomization/overlays/prod/crowdsec/**"
      ],
      "matchPackageNames": [
        "ghcr.io/cloudnative-pg/postgresql"
      ],
      "schedule": [
        "after 4pm on friday"
      ]
    },
    {
      "groupName": "postgres-forgejo",
      "matchFileNames": [
        "kustomization/overlays/prod/forgejo/**"
      ],
      "matchPackageNames": [
        "ghcr.io/cloudnative-pg/postgresql"
      ],
      "schedule": [
        "after 4pm on friday"
      ]
    },
    {
      "groupName": "postgres-homeassistant",
      "matchFileNames": [
        "kustomization/overlays/prod/homeassistant/**"
      ],
      "matchPackageNames": [
        "ghcr.io/cloudnative-pg/postgresql"
      ],
      "schedule": [
        "after 4pm on friday"
      ]
    },
    {
      "groupName": "postgres-immich",
      "matchFileNames": [
        "kustomization/overlays/prod/immich/**"
      ],
      "matchPackageNames": [
        "ghcr.io/cloudnative-pg/postgresql"
      ],
      "schedule": [
        "after 4pm on friday"
      ]
    },
    {
      "groupName": "postgres-manyfold",
      "matchFileNames": [
        "kustomization/overlays/prod/manyfold/**"
      ],
      "matchPackageNames": [
        "ghcr.io/cloudnative-pg/postgresql"
      ],
      "schedule": [
        "after 4pm on friday"
      ]
    },
    {
      "groupName": "postgres-monitoring",
      "matchFileNames": [
        "kustomization/overlays/prod/monitoring/**"
      ],
      "matchPackageNames": [
        "ghcr.io/cloudnative-pg/postgresql"
      ],
      "schedule": [
        "after 4pm on friday"
      ]
    },
    {
      "groupName": "postgres-paperless",
      "matchFileNames": [
        "kustomization/overlays/prod/paperless/**"
      ],
      "matchPackageNames": [
        "ghcr.io/cloudnative-pg/postgresql"
      ],
      "schedule": [
        "after 4pm on friday"
      ]
    },
    {
      "groupName": "postgres-tandoor",
      "matchFileNames": [
        "kustomization/overlays/prod/tandoor/**"
      ],
      "matchPackageNames": [
        "ghcr.io/cloudnative-pg/postgresql"
      ],
      "schedule": [
        "after 4pm on friday"
      ]
    },
    {
      "groupName": "postgres-weekly",
      "matchPackageNames": [
        "postgres"
      ],
      "schedule": [
        "after 4pm on friday"
      ]
    },
    {
      "automerge": true,
      "automergeType": "branch",
      "groupName": "redis",
      "matchPackageNames": [
        "quay.io/opstree/redis",
        "quay.io/opstree/redis-sentinel",
        "redis-operator"
      ],
      "matchUpdateTypes": [
        "digest",
        "minor",
        "patch"
      ],
      "schedule": [
        "after 4pm on friday"
      ]
    },
    {
      "groupName": "tdarr",
      "matchPackageNames": [
        "/^ghcr\\.io\\/haveagitgat\\/tdarr.*/"
      ]
    },
    {
      "groupName": "marinatedconcrete Unifi Network Application Kustomize Component",
      "groupSlug": "marinatedconcrete-kustomize-unifi-network-application",
      "matchCurrentValue": "kustomize-unifi-network-application@**",
      "matchPackageNames": [
        "marinatedconcrete/config"
